import gc
import json
import os
import hashlib
import torch

from PIL import Image
from pathlib import Path

# 3. Load and prepare your image

BATCH_SIZE = 2

for batch_start in range(0, len(image_paths), BATCH_SIZE):

    batch_paths = image_paths[batch_start: batch_start + BATCH_SIZE]

    batch_messages = []
    image_inputs = []
    input_lens = []

    print(f"\nProcessing batch starting at index: {batch_start}")

    for image_path in batch_paths:

        image = Image.open(image_path).convert("RGB")

        image_inputs.append(image)

        print("System tokens:", len(img_sys_prompt.split()))

        # Use the correct message structure for the processor
        messages = [
            {
                "role": "system",
                "content": [
                    {
                        "type": "text",
                        "text": img_sys_prompt
                    },
                ],
            },
            {
                "role": "user",
                "content": [
                    {
                        "type": "image",
                        "image": image,
                        "max_pixels": 65536
                    },
                    {
                        "type": "text",
                        "text": "Extract the table into structured JSON. Do not output <think> content."
                    },
                ],
            }
        ]

        batch_messages.append(messages)

    # Prepare prompt and inputs

    for i, img in enumerate(image_inputs):
        print(i, hashlib.md5(img.tobytes()).hexdigest())

    eos_token_id = processor.tokenizer.eos_token_id

    texts = [
        processor.apply_chat_template(
            m,
            tokenize=False,
            add_generation_prompt=True,
            enable_thinking=False
        )
        for m in batch_messages
    ]

    inputs = processor(
        text=texts,
        images=image_inputs,
        padding=True,
        padding_side='left',
        return_tensors="pt"
    ).to("cuda")

    input_len = inputs.input_ids.shape[1]

    input_lens.append(input_len)

    pad_token_id = processor.tokenizer.pad_token_id

    input_lens = (
        inputs.input_ids != pad_token_id
    ).sum(dim=1)

    print("user tokens:",
          len(str(batch_messages[0][1]).split()))

    torch.manual_seed(123)

    # 5. Generate output

    print("Batch size:", inputs.input_ids.shape[0])
    print("Batch size (texts):", len(texts))
    print("Batch size (images):", len(image_inputs))
    print("Seq len:", inputs.input_ids.shape[1])
    print("Input lens:", input_lens)

    print("Generating output...")

    output = model.generate(
        **inputs,
        max_new_tokens=32768,
        top_p=1.0,
        do_sample=False
    )

    print(output)

    responses = []

    for i in range(len(output)):

        parsed = None

        print(f"Output {i} length:", len(output[i]))

        generated_tokens = output[i][input_lens[i]:]

        response = processor.decode(
            generated_tokens,
            skip_special_tokens=True
        )

        responses.append(response)

        print(response)

        cleaned = response.strip()

        cleaned = clean_llm_output(cleaned)

        try:
            parsed = json.loads(cleaned)

        except json.JSONDecodeError as e:

            print("JSON error:", e)

            print("RAW output:\n", cleaned)

            continue

        out_json_fl_nm = (
            f"{Path(os.path.basename(batch_paths[i])).stem}.json"
        )

        with open(
            OUT_command_json_DIR / out_json_fl_nm,
            "w",
            encoding="utf-8"
        ) as file:

            json.dump(
                parsed,
                file,
                indent=2,
                ensure_ascii=False
            )

        print(f"Saved: {out_json_fl_nm}")

    # Cleanup GPU memory

    del output
    del responses
    del inputs
    del image_inputs
    del batch_messages

    torch.cuda.empty_cache()

    gc.collect()