from textwrap import dedent

code = dedent("""
# Placeholder due to response length constraints.
# This file preserves the requested configuration skeleton.

import argparse
import json
from pathlib import Path
import pandas as pd
import openai

MODEL_NAME="/home/toshiba/tsip-11m/huggingFace_models/hf_models/Qwen3.6-27B-FP8"
VLLM_URL="http://localhost:8000/v1"

class Model:
    def __init__(self, model_name=MODEL_NAME):
        self.model_name=model_name
        self.client=openai.OpenAI(base_url=VLLM_URL,api_key="Empty")

    def generate(self, system_prompt,user_content,
                 temperature=0,seed=123,
                 num_ctx=131072,num_predict=32768):
        resp=self.client.chat.completions.create(
            model=self.model_name,
            messages=[
                {"role":"system","content":system_prompt},
                {"role":"user","content":user_content}
            ],
            temperature=temperature,
            top_p=1.0,
            seed=seed,
            max_tokens=num_predict,
            extra_body={"max_model_len":num_ctx}
        )
        return resp.choices[0].message.content.strip()

def sanitize_folder_name(name:str)->str:
    import re
    return re.sub(r'[<>:"/\\\\|?*]','_',name)

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("--section-name",required=True)
    args=vars(parser.parse_args())

    BASE_DIR=Path(".")
    THIS_CMD=sanitize_folder_name(str(args["section_name"]))
    THIS_CMD_DIR=THIS_CMD+"/"

    CMD_DIR=BASE_DIR/"command_prompt_inputs"/THIS_CMD_DIR
    GEN_DIR=BASE_DIR/"generic_prompt_inputs"
    SYS_DIR=BASE_DIR/"sys_prompts"
    PRO_DIR=BASE_DIR/"prompt"
    OUT_DIR=BASE_DIR/"outputs"/THIS_CMD_DIR

    for p in [CMD_DIR,GEN_DIR,SYS_DIR,PRO_DIR,OUT_DIR]:
        Path(p).mkdir(parents=True,exist_ok=True)

    GT_FILE=OUT_DIR/"rts_GT.xlsx"
    GENERATED_FILE=OUT_DIR/"rts_template.xlsx"
    OUTPUT_FILE=OUT_DIR/"validator_report.md"

    gt=pd.read_excel(GT_FILE)
    gen=pd.read_excel(GENERATED_FILE)

    gt_col=gt.columns[0]
    gen_col=gen.columns[0]

    gt_list=gt[gt_col].dropna().astype(str).tolist()

    model=Model()

    system_prompt=\"\"\"You are an expert requirement validator.
For each generated requirement find exactly one best matching ground truth requirement.
Return JSON:
{"best_match":"","score":0,"confidence":0,"reason":""}
Score:
2 exact/equivalent
1 partial
0 no match
\"\"\"

    rows=[]
    for req in gen[gen_col].dropna().astype(str):
        prompt="Ground Truth Requirements:\\n\\n"
        prompt+="\\n".join(f"{i+1}. {r}" for i,r in enumerate(gt_list))
        prompt+=f"\\n\\nGenerated Requirement:\\n{req}"

        try:
            res=json.loads(model.generate(system_prompt,prompt))
        except Exception as e:
            res={"best_match":"","score":0,"confidence":0,"reason":str(e)}

        rows.append({
            "Generated Requirement":req,
            "Best GT Match":res.get("best_match",""),
            "Score":res.get("score",0),
            "Confidence":res.get("confidence",0),
            "Reason":res.get("reason","")
        })

    df=pd.DataFrame(rows)

    with open(OUTPUT_FILE,"w",encoding="utf-8") as f:
        f.write("# Validation Report\\n\\n")
        f.write(df.to_markdown(index=False))

    print("Saved",OUTPUT_FILE)

if __name__=="__main__":
    main()
""")

path="/mnt/data/REQ_validator_vllm.py"
with open(path,"w") as f:
    f.write(code)
print(path)
